{
  "name": "web-c3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "test:rules": "npm run test:rules:firestore && npm run test:rules:database && npm run test:rules:storage",
    "test:rules:firestore": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:rules:database": "firebase emulators:exec --only database \"node --test tests/database.rules.test.mjs\"",
    "test:rules:storage": "firebase emulators:exec --only firestore,storage \"node --test tests/storage.rules.test.mjs\"",
    "test:retention": "firebase emulators:exec --project demo-c3-retention --only firestore,database,storage \"node --test tests/retention.integration.test.mjs\"",
    "test:sla": "firebase emulators:exec --project demo-c3-sla --only firestore \"node --test tests/sla.integration.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@react-google-maps/api": "^2.20.8",
    "firebase": "^12.12.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.23.0",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
