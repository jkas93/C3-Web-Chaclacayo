rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function emergenciaOwner(emergenciaId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/emergencias/$(emergenciaId))
        && firestore.get(/databases/(default)/documents/emergencias/$(emergenciaId)).data.vecinoId == request.auth.uid;
    }

    function isOperator() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/operadores_c3/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/operadores_c3/$(request.auth.uid)).data.activo != false;
    }

    function isAdmin() {
      return isOperator()
        && firestore.get(/databases/(default)/documents/operadores_c3/$(request.auth.uid)).data.rol == 'ADMIN';
    }

    function emergenciaResponder(emergenciaId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/emergencias/$(emergenciaId))
        && (firestore.get(/databases/(default)/documents/emergencias/$(emergenciaId)).data.patrullaAsignadaId == request.auth.uid
        || (isOperator()
          && (firestore.get(/databases/(default)/documents/operadores_c3/$(request.auth.uid)).data.rol == 'ADMIN'
            || firestore.get(/databases/(default)/documents/operadores_c3/$(request.auth.uid)).data.rol
              == firestore.get(/databases/(default)/documents/emergencias/$(emergenciaId)).data.tipo)));
    }

    // Reglas para fotos de patrulleros
    match /patrulleros_fotos/{fileName} {
      allow read: if request.auth != null
                  && (fileName == request.auth.uid + '.webp' || isOperator());
      // Solo el dueño de la foto puede subirla/modificarla
      allow write: if request.auth != null && fileName == request.auth.uid + '.webp'
                   && request.resource.contentType.matches('image/webp')
                   && request.resource.size < 5 * 1024 * 1024; // max 5MB
    }

    // Reglas para fotos de vecinos
    match /vecinos_fotos/{fileName} {
      allow read: if request.auth != null
                  && (fileName == request.auth.uid + '.webp' || isAdmin());
      // Solo el dueño de la foto puede subirla/modificarla
      allow write: if request.auth != null && fileName == request.auth.uid + '.webp'
                   && request.resource.contentType.matches('image/webp')
                   && request.resource.size < 5 * 1024 * 1024; // max 5MB
    }

    // Evidencia de una emergencia: el vecino propietario la carga y solo el
    // propietario, la unidad asignada o un operador C3 pueden consultarla.
    match /emergencias_audio/{emergenciaId}/{fileName} {
      allow read: if request.auth != null
                  && (emergenciaOwner(emergenciaId) || emergenciaResponder(emergenciaId));
      // Primera carga únicamente. `resource == null` impide reemplazar evidencia
      // y `request.resource != null` impide borrarla desde un cliente.
      allow write: if request.auth != null
                   && emergenciaOwner(emergenciaId)
                   && resource == null
                   && request.resource != null
                   && request.resource.contentType.matches('audio/ogg')
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
