rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function operatorExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/operadores_c3/$(request.auth.uid));
    }

    function operatorData() {
      return get(/databases/$(database)/documents/operadores_c3/$(request.auth.uid)).data;
    }

    function isActiveOperator() {
      return operatorExists() && operatorData().activo != false;
    }

    function isAdmin() {
      return isActiveOperator() && operatorData().rol == 'ADMIN';
    }

    function operatesService(tipo) {
      return isActiveOperator()
        && (operatorData().rol == 'ADMIN' || operatorData().rol == tipo);
    }

    function isEmergencyOwner(data) {
      return signedIn() && data.vecinoId == request.auth.uid;
    }

    function isAssignedResponder(data) {
      return signedIn() && data.patrullaAsignadaId == request.auth.uid;
    }

    match /emergencias/{emergenciaId} {
      allow read: if isEmergencyOwner(resource.data)
                  || isAssignedResponder(resource.data)
                  || operatesService(resource.data.tipo);

      // Crear SOS requiere sesión, App Check y dispositivo vinculado; toda la
      // validación se realiza en crearEmergenciaVecino mediante Admin SDK.
      allow create: if false;

      // El vecino solo adjunta evidencia o ubicación. La unidad asignada solo
      // confirma llegada. Cierre, cancelación, falsa alarma, escalamiento y
      // asignación pasan por Cloud Functions (Admin SDK).
      allow update: if (
          isEmergencyOwner(resource.data)
          && request.resource.data.vecinoId == resource.data.vecinoId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'audioUrl', 'evidenciasAudioUrlsCsv', 'latitudActual',
            'longitudActual', 'ultimaActualizacionMs'
          ])
        ) || (
          isAssignedResponder(resource.data)
          && resource.data.estado == 'DESPACHADA'
          && request.resource.data.estado == 'EN_SITIO'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'horaLlegadaMs', 'ultimaActualizacionMs'
          ])
        );

      allow delete: if false;
    }

    match /patrulleros/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
                  || operatesService(resource.data.tipoServicio);
      allow create, delete: if false;
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'tokenFCM', 'fotoUrl', 'ultimaActualizacion',
                      'frenadasBruscasTotales', 'velocidadMaximaRegistrada'
                    ]);
    }

    match /usuarios/{dni} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, delete: if false;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'tokenFCM', 'fotoUrl', 'pinNormal',
                      'debeCambiarClave'
                    ]);
    }

    match /operadores_c3/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /enlaces_publicos/{tokenId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /cuadrantes/{cuadranteId} {
      allow read: if isActiveOperator();
      allow create, update, delete: if false;
    }

    match /auditoria/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /alertas_operativas/{alertaId} {
      allow read: if operatesService(resource.data.tipo);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
