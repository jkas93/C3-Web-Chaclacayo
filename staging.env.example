# El script se niega a operar si ambos valores no son idénticos.
C3_TARGET_PROJECT_ID=c3-chaclacayo
C3_ALLOWED_PROJECT_ID=c3-chaclacayo

# Proyecto productivo conocido. Nunca debe coincidir con TARGET durante staging.
C3_PRODUCTION_PROJECT_ID=c3-chaclacayo-produccion

# Usar Application Default Credentials. No copiar llaves dentro del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta-segura\staging-service-account.json

# Solo para migration:apply:
# C3_MIGRATION_CONFIRM=APLICAR_c3-chaclacayo

# Solo para migration:rollback:
# C3_ROLLBACK_CONFIRM=REVERTIR_c3-chaclacayo
