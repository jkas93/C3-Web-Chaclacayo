{
  "name": "functions",
  "description": "Cloud Functions for Chaclacayo Security",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "migration:inventory": "node migration/inventory.js",
    "migration:snapshot": "node migration/snapshot.js",
    "staging:reset:dry-run": "node migration/reset-staging.js",
    "staging:reset:apply": "node migration/reset-staging.js --apply",
    "staging:smoke": "node migration/smoke-staging.js",
    "migration:dry-run": "node migration/migrate-v2.js",
    "migration:apply": "node migration/migrate-v2.js --apply",
    "migration:verify": "node migration/verify-v2.js",
    "migration:rollback": "node migration/rollback-v2.js --apply"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0",
    "uuid": "11.1.1"
  }
}
